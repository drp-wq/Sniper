{
  "name": "sniper-bot",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node src/main.js",
    "report": "node src/report.js",
    "test": "node --test test/*.test.js",
    "test:telegram": "node scripts/verify-telegram.js",
    "scanner": "node src/scanner.js",
    "sim": "node scripts/simulate.js",
    "backtest": "node scripts/execute-backtest.js",
    "secret-scan": "node scripts/secret-scan.js",
    "build:dashboard": "./scripts/build-dashboard.sh",
    "lint:dashboard": "cd dashboard && npm run lint",
    "ci": "npm run secret-scan && npm test && npm run lint:dashboard && npm run build:dashboard"
  }
}
