# Copy to .env on the ANDROID device only. Never commit .env.
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
WORKER_URL=https://sniper-relay.YOURNAME.workers.dev
APP_KEY=long-random-string-same-as-worker-secret
