# POLL_MS=3000
# PRICE_MS=5000
# MAX_SIGNAL_AGE_MS=60000
# MAX_OPEN=5
# MIN_LIQ_USD=15000
# MAX_TOP10_PCT=35
# ENTRY_SLIP=0.05
# EXIT_SLIP=0.08
