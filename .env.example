# Copy to .env on the ANDROID device only. Never commit .env.
RPC_URL=https://mainnet.helius-rpc.com/?api-key=YOUR_HELIUS_KEY
WORKER_URL=https://sniper-relay.YOURNAME.workers.dev
APP_KEY=long-random-string-same-as-worker-secret

# Optional Telegram alerts (phone direct dispatch or worker relay fallback)
# 1. Create a bot via @BotFather on Telegram -> get TG_TOKEN
# 2. Start the bot and get your numeric chat ID via @userinfobot -> get TG_CHAT
# 3. For worker alerts (heartbeat watchdog + halt alerts), also run:
#    npx wrangler secret put TG_TOKEN
#    npx wrangler secret put TG_CHAT
# TG_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ
# TG_CHAT=123456789
# Optional tuning
# POLL_MS=3000
# PRICE_MS=5000
# MAX_SIGNAL_AGE_MS=60000
# MAX_OPEN=5
# MIN_LIQ_USD=15000
# MAX_TOP10_PCT=35
# ENTRY_SLIP=0.05
# EXIT_SLIP=0.08
# ENTRY_QUOTE_RETRIES=2
# ENTRY_QUOTE_RETRY_MS=3000
# RPC_RETRIES=2
# RPC_RETRY_MS=500
# MAX_UNRESOLVED_MIN=30
